From dd3620cf4c639b4a9d0d328fb63aa6f0bea08e29 Mon Sep 17 00:00:00 2001
From: brybranmuffin <bryantbettencourt2026@u.northwestern.edu>
Date: Sun, 15 Nov 2026 15:30:01 -0600
Subject: [PATCH 1/2] Read base seed from VWAH_SEED (default 123)

Why: the seed was hard-coded, so repeat runs of the scaling grid could not use a second seed.
The default is unchanged, so runs without VWAH_SEED behave exactly as before.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 eval/main.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/eval/main.py b/eval/main.py
index 28d6cae..f7eeb97 100644
--- a/eval/main.py
+++ b/eval/main.py
@@ -463,7 +463,8 @@ if __name__ == "__main__":
     from tqdm import tqdm
     from datetime import datetime
 
-    seed = 123
+    # Base seed; each case uses seed + case_idx. Override with VWAH_SEED to run more than one seed.
+    seed = int(os.environ.get('VWAH_SEED', '123'))
     random.seed(seed)
     np.random.seed(seed)
 
